PORT=5000

# ── Option 1: DATABASE_URL (Recommended for Aiven / Railway / Cloud) ──
# Paste the full connection URI from your MySQL provider dashboard:
# DATABASE_URL=mysql://username:password@hostname:port/database_name

# ── Option 2: Individual Variables (For local MySQL) ──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=driveway_db
DB_PORT=3306
DB_SSL=false

# Set USE_MOCK_DB=true to run without any MySQL connection (in-memory store)
USE_MOCK_DB=false
